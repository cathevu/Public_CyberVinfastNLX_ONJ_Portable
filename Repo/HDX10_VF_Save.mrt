              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text106>
            <Text107 Ref="231" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0.3,0.3,6.7,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>4f38dbed5c6e48688b98327c8d076df5</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text107</Name>
              <Page isRef="202" />
              <Parent isRef="212" />
              <Text>Bên Bán có nghĩa vụ cung cấp đầy đủ hóa đơn, chứng từ, tài liệu hợp lệ cho Khách Hàng.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text107>
          </Components>
          <Conditions isList="true" count="0" />
