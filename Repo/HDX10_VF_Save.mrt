          <ClientRectangle>0,0.2,7.13,4.9</ClientRectangle>
          <Components isList="true" count="12">
            <Text4 Ref="165" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0.2,0,6.8,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>d25ab8f222ae4125a8240b0f934478de</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text4</Name>
              <Page isRef="160" />
              <Parent isRef="164" />
              <Text>Tiến độ các đợt thanh toán tiếp theo như sau:</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text4>
            <Text6 Ref="166" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0.3,0.2,6.7,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12,Italic</Font>
              <Guid>25d1ac85f92d4adca165ecfa7cc50c04</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text6</Name>
              <Page isRef="160" />
              <Parent isRef="164" />
              <Text>Khách Hàng lựa chọn một trong hai hình thức thanh toán trả thẳng hoặc trả góp.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text6>
            <Text36 Ref="167" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0.2,0.4,6.8,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12,Underline</Font>
              <Guid>0d3be29d3dff4a7f9fd8111d4e71908a</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text36</Name>
              <Page isRef="160" />
              <Parent isRef="164" />
              <Text>Thanh toán trả thẳng:</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text36>
            <Text40 Ref="168" type="Text" isKey="true">
              <AllowHtmlTags>True</AllowHtmlTags>
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0.2,0.6,6.8,0.5</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>0f4a90b590b34dd39f3872a28a7558dc</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text40</Name>
              <Page isRef="160" />
              <Parent isRef="164" />
              <Text>Đợt 2: &lt;b&gt;{String.Format(System.Globalization.CultureInfo.GetCultureInfo("de-DE"), "{0:N0}", IIF(Table0.Tra_Thang = 1, Table0.T_GT2, 0))} VNĐ &lt;/b&gt; &lt;i&gt; (Bằng chữ : {IIF(Table0.Tra_Thang = 1, Table0.Bang_Chu_GT2, "Không đồng")}) &lt;/i&gt;   Khách Hàng thanh toán trong vòng 07 (bảy) ngày làm việc kể từ ngày Bên Bán thông báo về việc Xe sẵn có để giao cho Khách Hàng.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <TextQuality>Wysiwyg</TextQuality>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text40>
            <Text42 Ref="169" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0.2,1.1,6.8,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12,Underline</Font>
              <Guid>9c896967af7547bf8acca6e14b547da9</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text42</Name>
              <Page isRef="160" />
              <Parent isRef="164" />
              <Text>Thanh toán trả góp:</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text42>
            <Text44 Ref="170" type="Text" isKey="true">
              <AllowHtmlTags>True</AllowHtmlTags>
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0.2,1.3,6.8,1</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>e60acd9a996c4963bf03a5777ec82eb7</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text44</Name>
              <Page isRef="160" />
              <Parent isRef="164" />
              <Text>Đợt 2: &lt;b&gt;{String.Format(System.Globalization.CultureInfo.GetCultureInfo("de-DE"), "{0:N0}", IIF(Table0.Tra_Gop = 1, Table0.T_GT2, 0))} VNĐ &lt;/b&gt; (&lt;i&gt; Bằng chữ : {IIF(Table0.Tra_Gop = 1, Table0.Bang_Chu_GT2, "Không đồng")}) &lt;/i&gt; . Khách Hàng thanh toán trong vòng 07 (bảy) ngày làm việc kể từ ngày Bên Bán thông báo về việc Xe sẵn có để giao cho Khách Hàng hoặc thanh toán theo thỏa thuận khác giữa Các Bên, Khách Hàng đồng thời bàn giao cho Bên Bán bản gốc Thông Báo Tín Dụng của ngân hàng cam kết cho Khách Hàng vay số tiền &lt;b&gt;{String.Format(System.Globalization.CultureInfo.GetCultureInfo("de-DE"), "{0:N0}", Table0.T_Tien_NH)} VNĐ &lt;/b&gt;(&lt;i&gt; Bằng chữ : {Table0.Bang_Chu_T_Tien_NH}) &lt;/i&gt; để mua Xe.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <TextQuality>Wysiwyg</TextQuality>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text44>
            <Text48 Ref="171" type="Text" isKey="true">
              <AllowHtmlTags>True</AllowHtmlTags>
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0,3,7,0.9</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>a898344175204b9a803080449ddd34fb</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text48</Name>
              <Page isRef="160" />
              <Parent isRef="164" />
              <Text>&lt;b&gt; &lt;i&gt; Để được đảm bảo quyền lợi, tất cả các đợt thanh toán, khách hàng vui lòng chuyển khoản vào tài khoản nêu trong hợp đồng này hoặc nộp tiền trực tiếp tại quầy thu ngân của công ty {ToUpperCase(Table0.Ten_Cty)}. &lt;/b&gt; &lt;/i&gt; &lt;br&gt;
&lt;br&gt;1.4 Phương thức thanh toán</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <TextQuality>Wysiwyg</TextQuality>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text48>
            <Text59 Ref="172" type="Text" isKey="true">
              <AllowHtmlTags>True</AllowHtmlTags>
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0.2,2.3,6.8,0.7</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>cf8be36dfcf0481ebd4f81f390e2a8a2</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text59</Name>
              <Page isRef="160" />
              <Parent isRef="164" />
              <Text>Đợt 3:  &lt;b&gt;{String.Format(System.Globalization.CultureInfo.GetCultureInfo("de-DE"), "{0:N0}", IIF(Table0.Tra_Gop = 1, Table0.T_Tien_NH, 0))} VNĐ &lt;/b&gt; (&lt;i&gt; Bằng chữ : {IIF(Table0.Tra_Gop = 1, Table0.Bang_Chu_T_Tien_NH, "Không đồng")}) &lt;/i&gt;. Số tiền này phải được ngân hàng cấp Thông Báo Tín Dụng thanh toán vào tài khoản của Bên Bán trong vòng 05 (năm) ngày làm việc kể từ ngày Bên Bán và Khách Hàng bàn giao giấy hẹn trả kết quả đăng ký Xe cho ngân hàng này.&lt;br&gt;</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <TextQuality>Wysiwyg</TextQuality>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text59>
            <CheckBox1 Ref="173" type="CheckBox" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <Checked>{IIF(Table0.Tra_Thang = 1,True,False)}</Checked>
              <ClientRectangle>0,0.4,0.2,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <ContourColor>Black</ContourColor>
