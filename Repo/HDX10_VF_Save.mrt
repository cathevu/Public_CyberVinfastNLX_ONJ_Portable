        <ReportSummaryBand6 Ref="177" type="ReportSummaryBand" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,5.5,7.13,1.8</ClientRectangle>
          <Components isList="true" count="10">
            <Text81 Ref="178" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>0,0.1,7,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12,Bold</Font>
              <Guid>4557e5075cdc416684424d7960a987cc</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text81</Name>
              <Page isRef="160" />
              <Parent isRef="177" />
              <Text>Điều 2: Thời gian, địa điểm giao Xe</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text81>
            <Text82 Ref="179" type="Text" isKey="true">
              <AllowHtmlTags>True</AllowHtmlTags>
              <Brush>Transparent</Brush>
              <CanBreak>True</CanBreak>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0.3,0.3,6.7,0.9</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>e8b8a4ef5d184207a8a43c2de9a8b14e</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text82</Name>
              <Page isRef="160" />
              <Parent isRef="177" />
              <Text>Thời gian giao Xe: &lt;br&gt; 
- {Table0.Thang_Gx} Theo thông báo của Bên Bán trước ít nhất 07 ngày làm việc (đối với mua hàng qua kênh trực tuyến)&lt;sup&gt;2&lt;/Sup&gt; &lt;br&gt;
- Thời gian dự kiến giao xe có thể thay đổi căn cứ vào thỏa thuận và thống nhất điều chỉnh giữa bên mua và bên bán. &lt;br&gt;
</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <TextQuality>Wysiwyg</TextQuality>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text82>
            <Text90 Ref="180" type="Text" isKey="true">
              <AllowHtmlTags>True</AllowHtmlTags>
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0.3,1.2,6.7,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>7929f78c04ee411ca1fc39214f73b5da</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text90</Name>
              <Page isRef="160" />
              <Parent isRef="177" />
              <Text>Địa điểm giao xe: &lt;b&gt; {Table0.Dia_DiemGx} &lt;/b&gt;</Text>
