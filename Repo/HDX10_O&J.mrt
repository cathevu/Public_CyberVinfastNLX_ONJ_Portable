              <Guid>f8fe4ebb0c6f49779a9eb7c7434f78fd</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text62</Name>
              <Page isRef="157" />
              <Parent isRef="160" />
              <Text>Việc thanh toán Giá trị Hợp đồng được thực hiện như sau:</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
