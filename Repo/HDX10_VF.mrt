          <Components isList="true" count="12">
            <Text53 Ref="170" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0.2,0,6.4,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
