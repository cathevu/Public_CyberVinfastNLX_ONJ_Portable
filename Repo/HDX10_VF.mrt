              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <Checked>{IIF(Table0.Tra_Thang = 1,True,False)}</Checked>
              <ClientRectangle>0,0.4,0.2,0.2</ClientRectangle>
