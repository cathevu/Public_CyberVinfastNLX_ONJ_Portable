              <Name>Text53</Name>
              <Page isRef="164" />
              <Parent isRef="169" />
              <Text>Tiến độ các đợt thanh toán tiếp theo như sau:</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
