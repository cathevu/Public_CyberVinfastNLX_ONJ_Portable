              <Font>Times New Roman,11.5</Font>
              <Guid>f9df9f9b022c496fa6f962417e2af0fb</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text63</Name>
              <Page isRef="164" />
              <Parent isRef="169" />
              <Text>Đợt 2: &lt;b&gt;{Format("{0:N0}", Table0.T_GT2)} VNĐ &lt;/b&gt; (&lt;i&gt; (Bằng chữ : {Table0.Bang_Chu_GT2}) &lt;/i&gt;   Khách Hàng thanh toán trong vòng 07 (bảy) ngày làm việc kể từ ngày Bên Bán thông báo về việc Xe sẵn có để giao cho Khách Hàng.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <TextQuality>Wysiwyg</TextQuality>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text63>
            <Text78 Ref="174" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
