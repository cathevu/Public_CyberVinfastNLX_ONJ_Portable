              <Margins>0,0,0,0</Margins>
              <Name>Text7</Name>
              <Page isRef="9" />
              <Parent isRef="15" />
              <Text>&lt;b&gt;KHÁCH HÀNG : {Table0.Ten_kh}&lt;/b&gt;&lt;br&gt;
Địa chỉ : {Table0.Dia_Chi}&lt;br&gt;
Điện thoại : {Table0.Dien_Thoai}&lt;br&gt;
Email : {Table0.E_Mail}&lt;br&gt;
{Table0.Str_Giay_To}&lt;br&gt;
</Text>
              <TextBrush>Black</TextBrush>
              <TextQuality>Wysiwyg</TextQuality>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text7>
            <Text8 Ref="19" type="Text" isKey="true">
              <AllowHtmlTags>True</AllowHtmlTags>
              <Brush>Transparent</Brush>
              <CanBreak>True</CanBreak>
              <CanGrow>True</CanGrow>
              <ClientRectangle>10,78,166,18</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>addc7103ce8f41ef938c1a024ef431c1</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text8</Name>
              <Page isRef="9" />
              <Parent isRef="15" />
              <Text>- Căn cứ Hợp đồng mua bán số &lt;b&gt;{Table0.Ma_HD_KH}&lt;/b&gt; &lt;br&gt;
- Căn cứ &lt;b&gt;{Table1.Ten_CSBH}&lt;/b&gt; &lt;br&gt;
- Sau khi bàn bạc và trao đổi, hai Bên đồng ý ký Phụ lục Hợp đồng này điều chỉnh điều khoản của Hợp đồng số &lt;b&gt;{Table0.Ma_HD_KH} {Table0.Ngay_HD}&lt;/b&gt; cụ thể như sau: &lt;br&gt;
</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <TextQuality>Wysiwyg</TextQuality>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text8>
            <Text9 Ref="20" type="Text" isKey="true">
              <AllowHtmlTags>True</AllowHtmlTags>
              <Brush>Transparent</Brush>
              <CanBreak>True</CanBreak>
              <CanGrow>True</CanGrow>
              <ClientRectangle>2,74,174,4</ClientRectangle>
              <Conditions isList="true" count="0" />
